# Copy to .env.local for local development. In Vercel, add these in Project Settings > Environment Variables.
# Never commit real values. Leave everything blank to run the demo (in-memory data, simulated AI).

# Supabase: turns on the live database and email sign-in. The publishable key is safe in the browser
# because row-level security protects every table. Never put a service_role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated accounts allowed to use the workspace, for example ram@example.com
ALLOWED_EMAILS=
# Set to true only while creating your own first account, then remove it.
ALLOW_SIGNUPS=

# Live AI runs (server only, never NEXT_PUBLIC). Without a key, runs are simulated and clearly labelled.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_MS=90000
AI_DAILY_BUDGET_USD=5
# AI_PROVIDER=simulated forces simulated runs even when a key is present.

# Production demo without Supabase is read-only unless this is true.
ALLOW_PUBLIC_DEMO=
